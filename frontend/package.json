    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "^9.17.0",
    "jsdom": "^28.0.0",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vitest": "^4.0.18"
